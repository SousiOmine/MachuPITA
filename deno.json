{
  "lock": true,
  "nodeModulesDir": "auto",
  "name": "machupita",
  "version": "0.1.0",
  "exports": "./main.ts",
  "bin": {
    "machupita": "./main.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.window", "deno.ns", "esnext"]
  },
  "lint": {
    "include": ["main.ts", "engine/", "cli/", "tests/", "tools/"],
    "rules": {
      "exclude": ["require-await"]
    }
  },
  "fmt": {
    "include": ["main.ts", "engine/", "cli/", "tests/", "tools/"]
  },
  "tasks": {
    "cli": "deno run -A main.ts",
    "install:global": "deno install -g -f -A -c deno.json -n machupita main.ts",
    "check": "deno check main.ts engine/ cli/ tests/ tools/",
    "test": "deno test -A",
    "setup:fonts": "deno run -A tools/get-fonts.ts",
    "compile": "deno compile -A --output machupita main.ts"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@deno-ink/core": "jsr:@deno-ink/core@0.2.1",
    "react": "npm:react@18.3.1",
    "@types/react": "npm:@types/react@^18.3.12",
    "unpdf": "npm:unpdf@1.8.1",
    "@napi-rs/canvas": "npm:@napi-rs/canvas@1.0.7",
    "@cantoo/pdf-lib": "npm:@cantoo/pdf-lib@2.9.1",
    "fontkit": "npm:fontkit@2.0.4",
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@0.84.2"
  }
}
